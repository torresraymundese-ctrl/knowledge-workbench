{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-workbench.local/schemas/conflict-candidate-pack-v1.json",
  "title": "Cross-document conflict candidate annotation pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "pack_id", "generated_at", "generated_by",
    "minimum_similarity", "statistics", "candidates"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "cross-document-conflict-candidate-pack"},
    "pack_id": {"type": "string", "pattern": "^cpack_[a-f0-9]{24}$"},
    "generated_at": {"type": "string", "minLength": 1},
    "generated_by": {"type": "string", "minLength": 1},
    "minimum_similarity": {"type": "number", "minimum": 0, "maximum": 1},
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible_evidence_count", "restricted_evidence_excluded",
        "total_candidate_count", "exported_candidate_count", "truncated"
      ],
      "properties": {
        "eligible_evidence_count": {"type": "integer", "minimum": 0},
        "restricted_evidence_excluded": {"type": "integer", "minimum": 0},
        "total_candidate_count": {"type": "integer", "minimum": 0},
        "exported_candidate_count": {"type": "integer", "minimum": 0},
        "truncated": {"type": "boolean"}
      }
    },
    "candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"}
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id", "document_id", "document_name", "document_version_id",
        "processing_run_id", "classification", "excerpt", "locators"
      ],
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^ev_[a-f0-9]+$"},
        "document_id": {"type": "string", "pattern": "^doc_[a-f0-9]+$"},
        "document_name": {"type": "string", "minLength": 1},
        "document_version_id": {"type": "string", "pattern": "^ver_[a-f0-9]+$"},
        "processing_run_id": {"type": "string", "pattern": "^run_[A-Za-z0-9_]+$"},
        "classification": {"enum": ["public", "internal", "confidential"]},
        "excerpt": {"type": "string", "minLength": 1},
        "locators": {"type": "array", "minItems": 1, "items": {"type": "object"}}
      }
    },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_conflict", "expected_type", "note"],
      "properties": {
        "expected_conflict": {"type": ["boolean", "null"]},
        "expected_type": {
          "type": ["string", "null"],
          "enum": ["polarity_change", "value_change", null]
        },
        "note": {"type": ["string", "null"]}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "note"],
      "properties": {
        "decision": {"type": ["string", "null"], "enum": ["approved", "rejected", null]},
        "note": {"type": ["string", "null"]}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id", "left", "right", "predicted_conflict",
        "predicted_type", "similarity", "reason", "label", "review"
      ],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^xdoc_[a-f0-9]{20}$"},
        "left": {"$ref": "#/$defs/evidence"},
        "right": {"$ref": "#/$defs/evidence"},
        "predicted_conflict": {"type": "boolean"},
        "predicted_type": {
          "type": ["string", "null"],
          "enum": ["polarity_change", "value_change", null]
        },
        "similarity": {"type": "number", "minimum": 0, "maximum": 1},
        "reason": {"type": ["string", "null"]},
        "label": {"$ref": "#/$defs/label"},
        "review": {"$ref": "#/$defs/review"}
      }
    }
  }
}
