{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-workbench.local/schemas/conflict-evaluation-v1.json",
  "title": "Conflict detection evaluation dataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "cases"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "name": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id", "older", "newer", "expected_conflict", "expected_type"
        ],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "older": {"type": "string", "minLength": 1},
          "newer": {"type": "string", "minLength": 1},
          "expected_conflict": {"type": "boolean"},
          "expected_type": {
            "type": ["string", "null"],
            "enum": ["polarity_change", "value_change", null]
          }
        }
      }
    }
  }
}
