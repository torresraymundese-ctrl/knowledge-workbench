{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-workbench.local/schemas/evaluation-dataset-v1.json",
  "title": "Knowledge workbench evaluation dataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "cases"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "name": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id", "source_path", "classification", "expected_evidence",
          "forbidden_substrings", "max_duplicate_rate"
        ],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "source_path": {"type": "string", "minLength": 1},
          "classification": {
            "enum": ["public", "internal", "confidential", "restricted"]
          },
          "expected_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "required"],
              "properties": {
                "text": {"type": "string", "minLength": 1},
                "required": {"type": "boolean"}
              }
            }
          },
          "forbidden_substrings": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "max_duplicate_rate": {
            "type": "number", "minimum": 0, "maximum": 1
          }
        }
      }
    }
  }
}
