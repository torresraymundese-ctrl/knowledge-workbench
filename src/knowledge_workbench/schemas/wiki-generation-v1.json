{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-workbench.local/schemas/wiki-generation-v1.json",
  "title": "Stage 2 Wiki generation result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "analysis_schema_version", "pages", "human_tasks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "analysis_schema_version": {"const": "1.0"},
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "slug_suggestion", "summary", "conclusions", "evidence_sections", "links"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "slug_suggestion": {"type": "string", "minLength": 1},
          "summary": {"type": ["string", "null"]},
          "conclusions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "evidence_ids", "confidence", "applicability"],
              "properties": {
                "text": {"type": "string", "minLength": 1},
                "evidence_ids": {
                  "type": "array", "minItems": 1, "uniqueItems": true,
                  "items": {"type": "string", "pattern": "^E[0-9]{4,}$"}
                },
                "confidence": {"enum": ["low", "medium", "high"]},
                "applicability": {"type": ["string", "null"]}
              }
            }
          },
          "evidence_sections": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["heading", "evidence_ids"],
              "properties": {
                "heading": {"type": "string", "minLength": 1},
                "evidence_ids": {
                  "type": "array", "minItems": 1, "uniqueItems": true,
                  "items": {"type": "string", "pattern": "^E[0-9]{4,}$"}
                }
              }
            }
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["target", "relationship", "evidence_ids"],
              "properties": {
                "target": {"type": "string", "minLength": 1},
                "relationship": {"type": "string", "minLength": 1},
                "evidence_ids": {
                  "type": "array", "minItems": 1, "uniqueItems": true,
                  "items": {"type": "string", "pattern": "^E[0-9]{4,}$"}
                }
              }
            }
          }
        }
      }
    },
    "human_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_type", "description", "evidence_ids"],
        "properties": {
          "task_type": {"enum": ["synthesize", "verify", "resolve_conflict", "fill_gap"]},
          "description": {"type": "string", "minLength": 1},
          "evidence_ids": {
            "type": "array", "uniqueItems": true,
            "items": {"type": "string", "pattern": "^E[0-9]{4,}$"}
          }
        }
      }
    }
  }
}
