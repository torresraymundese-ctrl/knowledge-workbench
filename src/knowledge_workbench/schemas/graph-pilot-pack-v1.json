{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-workbench.local/schemas/graph-pilot-pack-v1.json",
  "title": "Graph pilot evidence review pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "pack_id",
    "generated_at",
    "generated_by",
    "source_labeling_session",
    "workflow",
    "statistics",
    "candidates"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "graph-pilot-evidence-pack"},
    "pack_id": {
      "type": "string",
      "pattern": "^graphpilot_[a-f0-9]{32}$"
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "generated_by": {"type": "string", "minLength": 1, "maxLength": 80},
    "source_labeling_session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "name",
        "created_by",
        "approved_by",
        "case_count"
      ],
      "properties": {
        "session_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "created_by": {"type": "string", "minLength": 1},
        "approved_by": {"type": "string", "minLength": 1},
        "case_count": {"type": "integer", "minimum": 1}
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "automatic_status_changes",
        "automatic_entity_creation",
        "automatic_relationship_creation"
      ],
      "properties": {
        "purpose": {
          "const": "manual-evidence-review-and-entity-graph-pilot"
        },
        "automatic_status_changes": {"const": false},
        "automatic_entity_creation": {"const": false},
        "automatic_relationship_creation": {"const": false}
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_evidence_count",
        "exported_evidence_count",
        "restricted_evidence_excluded",
        "status_counts"
      ],
      "properties": {
        "selected_evidence_count": {"type": "integer", "minimum": 1},
        "exported_evidence_count": {"type": "integer", "minimum": 1},
        "restricted_evidence_excluded": {"type": "integer", "minimum": 0},
        "status_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "case_ids",
          "status",
          "run_ordinal",
          "document_id",
          "document_version_id",
          "processing_run_id",
          "document_name",
          "classification",
          "excerpt",
          "locators"
        ],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "case_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "status": {
            "enum": [
              "draft",
              "reviewing",
              "verified",
              "conflicted"
            ]
          },
          "run_ordinal": {"type": "integer", "minimum": 1},
          "document_id": {"type": "string", "minLength": 1},
          "document_version_id": {"type": "string", "minLength": 1},
          "processing_run_id": {"type": "string", "minLength": 1},
          "document_name": {"type": "string", "minLength": 1},
          "classification": {
            "enum": ["public", "internal", "confidential"]
          },
          "excerpt": {"type": "string", "minLength": 1},
          "locators": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "object"}
          }
        }
      }
    }
  }
}
